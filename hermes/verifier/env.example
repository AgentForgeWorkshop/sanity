# Placeholders only. Copy into the profile .env and fill in. Do not commit the copy.
# Docker defaults shown; scripts/setup_verifier_docker.sh sets the two SANITY_ lines.
SANITY_REPO=/opt/data/sanity
SANITY_PYTHON=/opt/data/sanity-venv/bin/python
MODEL_PROVIDER=YOUR_PROVIDER
MODEL_NAME=YOUR_PROVIDER/YOUR_MODEL
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
# Ilkham, Konstantin, Lloyd, the Reader bot, the Writer bot, and the group ID:
TELEGRAM_ALLOWED_USERS=ID_1,ID_2,ID_3,READER_BOT_ID,WRITER_BOT_ID,GROUP_ID
TELEGRAM_REQUIRE_MENTION=true
# Role wake word: messages with "to=verifier" in the sanity header reach this bot.
TELEGRAM_MENTION_PATTERNS=sanity run=[^ ]+ .*to=verifier
