# Placeholders only. Copy to the profile .env and fill in. Do not commit the copy.
SANITY_REPO=/ABSOLUTE/PATH/TO/SANITY
MODEL_PROVIDER=YOUR_PROVIDER
MODEL_NAME=YOUR_PROVIDER/YOUR_MODEL
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
# The three people, the two other Sanity bots, and the group ID:
TELEGRAM_ALLOWED_USERS=ID_1,ID_2,ID_3,OTHER_BOT_ID_1,OTHER_BOT_ID_2,GROUP_ID
TELEGRAM_REQUIRE_MENTION=true
# Role wake word: messages with "to=reader" in the sanity header reach this bot (skills/sanity-protocol).
TELEGRAM_MENTION_PATTERNS=sanity run=[^ ]+ .*to=reader
# The Sanity group as a `hermes send` target, for messages during a long turn:
SANITY_GROUP=telegram:-GROUP_ID
